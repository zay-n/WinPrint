{
  "name": "winprint-backend-functions",
  "description": "Winsoft Print Station — Firebase Cloud Functions backend",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
